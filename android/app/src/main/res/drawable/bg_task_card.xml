<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_bg_focus" />
            <stroke
                android:width="@dimen/hm_focus_stroke"
                android:color="@color/hm_focus_ring" />
            <corners android:radius="@dimen/hm_card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/hm_panel_border" />
            <corners android:radius="@dimen/hm_card_corner" />
        </shape>
    </item>
</selector>
