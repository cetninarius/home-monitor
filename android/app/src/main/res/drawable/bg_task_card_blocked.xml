<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_accent_red_dim" />
            <stroke
                android:width="@dimen/hm_focus_stroke"
                android:color="@color/hm_accent_red_border" />
            <corners android:radius="@dimen/hm_card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_accent_red_dim" />
            <stroke
                android:width="2dp"
                android:color="@color/hm_accent_red_border" />
            <corners android:radius="@dimen/hm_card_corner" />
        </shape>
    </item>
</selector>
