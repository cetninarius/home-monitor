<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#331A222C" />
            <stroke
                android:width="3dp"
                android:color="@color/hm_focus_ring" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_accent_cyan_dim" />
            <stroke
                android:width="2dp"
                android:color="@color/hm_accent_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22141820" />
            <stroke
                android:width="1dp"
                android:color="@color/hm_panel_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
