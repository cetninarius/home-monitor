<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/servicesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_panel">

    <LinearLayout
        android:id="@+id/servicesExpanded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/services_title"
            android:textColor="@color/hm_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/servicesMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/hm_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Wide bottom strip: horizontal cards -->
        <HorizontalScrollView
            android:id="@+id/servicesHScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/servicesRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- HOME left rail: stacked full-width cards (HorizontalScrollView cannot do this) -->
        <ScrollView
            android:id="@+id/servicesVScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/servicesCompact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/services_title"
            android:textColor="@color/hm_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/servicesCompactDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
